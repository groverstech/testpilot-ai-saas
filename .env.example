# ─── TestPilot AI — environment template ────────────────────────────────────
# Copy to .env and fill in. Never commit .env. Values marked (secret) must be kept private.

NODE_ENV=development

# Database (PostgreSQL 14+). The test suite uses DATABASE_URL_TEST.
DATABASE_URL=postgresql://testpilot:testpilot@localhost:5432/testpilot
DATABASE_URL_TEST=postgresql://testpilot:testpilot@localhost:5432/testpilot_test

# Redis (BullMQ queues, distributed rate limiting)
REDIS_URL=redis://localhost:6379

# URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Sessions / cookies. COOKIE_SECURE must be true in production (HTTPS).
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# (secret) 32-byte base64 key(s) for encrypting project secrets & tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: ENCRYPTION_KEYS=new:<b64>,old:<b64>  (first is used to encrypt)
ENCRYPTION_KEYS=

# Email: SMTP_URL enables real delivery (required in production).
# Without it, development prints emails (with their links) to the API log.
SMTP_URL=
EMAIL_FROM="TestPilot AI <no-reply@testpilot.local>"

# Development only: allow http://localhost:* etc. as a project's application URL.
ALLOW_PRIVATE_APP_URLS=true
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false
LOG_LEVEL=info

# ─── Integrations (optional in Phase 1; reported on the Integrations page) ───
# GitHub App (Phase 2)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub OAuth sign-in (Phase 2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Anthropic Claude (Phase 3)
ANTHROPIC_API_KEY=
# S3-compatible object storage (Phase 4)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Stripe (Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional per-plan quota overrides, e.g. {"FREE":{"projects":3}}
PLAN_LIMITS_JSON=
