{
  "name": "testpilot-ai",
  "private": true,
  "version": "0.1.0",
  "description": "TestPilot AI \u2014 autonomous AI-powered QA SaaS platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts --trace off",
    "db:generate": "pnpm --filter @testpilot/database generate",
    "db:migrate": "pnpm --filter @testpilot/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @testpilot/database migrate:dev",
    "db:seed": "pnpm --filter @testpilot/database seed",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@testpilot/shared": "workspace:*",
    "@testpilot/testing": "workspace:*",
    "@types/node": "^22.19.0",
    "dotenv": "^16.6.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fastify": "^5.6.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  },
  "type": "module"
}
